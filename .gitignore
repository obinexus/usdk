# USDK: keep packages/ source, manifests, lockfiles and research tracked.

# Extracted reference archives (read-only, cited by docs/RESEARCH_REVIEW.md,
# not part of USDK's own source - the original .zip files stay in Downloads/)
/reference/

# JavaScript dependencies and caches (all workspaces)
node_modules/
.npm/
.pnpm-store/
.vite/
.parcel-cache/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Generated builds and local installs
/build/
/build-*/
/cmake-build-*/
/install/
/install-*/
/dist/
packages/**/build/
packages/**/dist/
CMakeFiles/
CMakeCache.txt
CMakeUserPresets.json

# Python environments and generated metadata
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Test reports and tool caches
coverage/
.nyc_output/
playwright-report/
test-results/
.cache/

# Local credentials; retain example configuration
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Local runtime state (keep intentional recording fixtures tracked)
usdk-run/
uagent-run/
obicall-run/
*.pid
*.pid.lock

# Editor and operating-system temporary files
.vs/
*.suo
*.user
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
